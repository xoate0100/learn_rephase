{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xoate0100/project_initializer/schemas/content_ir/rubric_spec.schema.json",
  "title": "Rubric spec v1 (DEC-FAC-0010)",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric_id", "version", "dimensions"],
  "properties": {
    "rubric_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "voice_spec_ref": {
            "type": "string",
            "description": "Required for dimension 6 (voice conformance)"
          }
        }
      }
    }
  }
}
